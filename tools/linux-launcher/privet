#!/usr/bin/env bash
# Opens Privet desktop window (Chrome/Edge/Chromium app mode).
set -euo pipefail
URL="${PRIVET_URL:-https://messenger.banderdog.com}"
for bin in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge; do
  if command -v "$bin" >/dev/null 2>&1; then
    exec "$bin" --app="$URL" --new-window
  fi
done
if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$URL"
fi
echo "Install Chrome/Chromium, then re-run ./privet" >&2
exit 1
