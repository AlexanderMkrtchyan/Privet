# Firebase Cloud Messaging — copy to firebase.env and fill from Firebase console.
# Run: scripts/setup-firebase.sh (one-time) to create the project and this file.
#
# These values are baked into the Android APK at build time.

PRIVET_FCM_API_KEY=
PRIVET_FCM_APP_ID=
PRIVET_FCM_SENDER_ID=
PRIVET_FCM_PROJECT_ID=

# Server-only (add to server/.env on production — NOT baked into the APK):
# PRIVET_FCM_SERVER_KEY=
