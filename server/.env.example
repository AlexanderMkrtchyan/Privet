# JWT for production (required on prod)
# JWT_SECRET=change-me

# Prefer OpenAI-compatible server key (DeepSeek by default) then Gemini free tier.
# Users paste their own key + base URL + model in Profile settings (sent per AI request).
# PRIVET_AI_PROVIDER=auto|openai|deepseek|gemini
PRIVET_AI_PROVIDER=auto

# OpenAI-compatible server defaults (DeepSeek env names still work)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4o-mini
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini (example default; users pick their own model in the app)
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-2.5-flash-lite
